# Copy to ".env" and fill in real values. Never commit .env to Git.
#   copy .env.example .env   (Windows)
#   cp .env.example .env    (macOS/Linux)

# --- Django core (required in production) ---
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS site (production): comma-separated origins, no trailing slash on path
# Example: https://yourapp.onrender.com,https://www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# When DEBUG=0 and behind HTTPS, set to 1 if your host terminates TLS (e.g. Render, Railway)
SECURE_SSL_REDIRECT=0

# --- Database ---
# Leave empty or unset for local SQLite (db.sqlite3).
# PostgreSQL example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Email (password reset, notifications) ---
# Local dev default: console backend (emails print in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lux Gems <noreply@luxgems.local>

# SMTP (production): switch backend and set these
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
